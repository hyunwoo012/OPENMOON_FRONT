# YullinMoon_Ver3.py와 동일한 실제 연결 설정
DAUM_LOGIN_ID=
DAUM_APP_PASSWORD=
OPENAI_API_KEY=

OPENAI_MODEL=gpt-4.1-mini
ALLOW_LIVE_SEND=false
# true면 승인/답장을 고객이 아니라 현재 DAUM_LOGIN_ID 자신에게 발송
SEND_TEST_TO_SELF=true

# 사용자 원본 엔진 데이터와 견적 양식
PRICE_DATABASE_PATH=backend/data/source/price_table.db
QUOTATION_DATABASE_PATH=backend/data/source/quotation_history.db
QUOTATION_TEMPLATE_PATH=backend/data/templates/quotation_template.xlsx
QUOTATION_TEMPLATE_SHEET=Main_Sheet
# 휴대용 EXE에서는 실행 파일 위치를 기준으로 상대 경로를 해석합니다.
QUOTATION_FILES_PATH=backend/data/quotation_files
USE_EXTERNAL_PRICE_ENGINE=true
