DAUM_LOGIN_ID=
DAUM_APP_PASSWORD=
OPENAI_API_KEY=

OPENAI_MODEL=gpt-4.1-mini

# 승인 테스트 모드: 고객 대신 아래 주소로만 발송합니다.
